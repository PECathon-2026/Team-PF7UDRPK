# Optional: Live PostgreSQL connection string (Neon / Supabase)
# If left unset or blank, Small Web Reader automatically runs on embedded in-memory PGlite.
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require"

# ── Fetch Proxy ──────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins for /api/fetch
ALLOWED_ORIGIN=http://localhost:3000

# ── Rate Limiter ─────────────────────────────────────────────────
# Secret used to key the rate-limiter salt
RATE_LIMIT_SECRET=change-me-in-production

# ── PoW Engine ───────────────────────────────────────────────────
# PoW challenge difficulty (number of leading zero hex chars required)
POW_DIFFICULTY=4

# PoW challenge TTL in seconds (default: 300 = 5 minutes)
POW_CHALLENGE_TTL_SECONDS=300
