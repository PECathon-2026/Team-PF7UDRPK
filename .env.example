# Environment Variables Template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.

# ── Fetch Proxy ──────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins for /api/fetch
# Example for production: https://yourapp.vercel.app
ALLOWED_ORIGIN=http://localhost:3000

# ── Rate Limiter ─────────────────────────────────────────────────
# Secret used to key the rate-limiter salt (adds extra entropy beyond the UUID)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SECRET=change-me-in-production

# ── PoW Engine ───────────────────────────────────────────────────
# PoW challenge difficulty (number of leading zero hex chars required)
# 4 = ~65k average attempts (good balance for hackathon)
POW_DIFFICULTY=4

# PoW challenge TTL in seconds (default: 300 = 5 minutes)
POW_CHALLENGE_TTL_SECONDS=300

